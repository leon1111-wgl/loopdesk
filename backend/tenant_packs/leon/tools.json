    "hints": {"intents": ["积分还有多少", "现在多少积分", "剩余积分", "积分还有", "积分还剩", "积分余额", "积分一共", "积分有多少", "积分够不够", "有多少积分", "我的积分", "查积分", "剩多少积分", "多少积分了", "我积分"]},
