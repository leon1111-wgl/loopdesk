[
  {"key": "small_refund_goes_through_once", "tenant": "leon", "why": "under the limit: automatic, and an order is refunded once",
   "steps": [
     {"as": "customer@leon.demo", "say": "SO20260918001 申请退款", "says": "39.90", "approval": false},
     {"as": "customer@leon.demo", "say": "SO20260918001 我要退款", "says": "不能重复申请退款|暂不能发起退款", "approval": false}
   ],
   "end": {"orders": {"SO20260918001": "refunding"}, "refunds": {"SO20260918001": 39.9}, "approvals": {}}},
  {"key": "over_the_limit_waits_then_approved", "tenant": "leon", "why": "the money moves only after a person says yes",
   "steps": [
     {"as": "customer@leon.demo", "say": "SO20261012003 我要退款", "says": "人工审核", "approval": true},
     {"check": {"orders": {"SO20261012003": "paid"}, "refunds": {}, "approvals": {"pending": 1}}},
     {"as": "agent@leon.demo", "decide": "approve", "comment": "核实无误"}
   ],
   "end": {"orders": {"SO20261012003": "refunding"}, "refunds": {"SO20261012003": 268.0}, "approvals": {"approved": 1}}},
  {"key": "rejected_leaves_the_order_alone", "tenant": "leon", "why": "a rejection needs a reason, moves nothing and reaches the customer",
   "steps": [
     {"as": "customer@leon.demo", "say": "SO20261012003 我要退款", "approval": true},
     {"as": "agent@leon.demo", "decide": "reject", "comment": "", "refused": 400},
     {"as": "agent@leon.demo", "decide": "reject", "comment": "凭证不足"}
   ],
   "end": {"orders": {"SO20261012003": "paid"}, "refunds": {}, "approvals": {"rejected": 1}, "last_message": "凭证不足"}},
  {"key": "above_the_admin_line_needs_an_admin", "tenant": "leon", "why": "an agent can reject it but not approve it; nobody approves their own",
   "steps": [
     {"as": "customer@leon.demo", "say": "SO20261008002 我要退款", "says": "人工审核", "approval": true},
     {"as": "agent@leon.demo", "decide": "approve", "comment": "", "refused": 403},
     {"as": "admin@leon.demo", "decide": "approve", "comment": "同意"}
   ],
   "end": {"orders": {"SO20261008002": "refunding"}, "refunds": {"SO20261008002": 1299.0}, "approvals": {"approved": 1}}},
  {"key": "withdrawn_in_two_steps", "tenant": "leon", "why": "the first step only explains; afterwards a reviewer can no longer pay it",
   "steps": [
     {"as": "customer@leon.demo", "say": "SO20261012003 我要退款", "approval": true},
     {"as": "customer@leon.demo", "say": "撤回 SO20261012003 的退款申请", "says": "确认撤回 SO20261012003"},
     {"check": {"approvals": {"pending": 1}}},
     {"as": "customer@leon.demo", "say": "确认撤回 SO20261012003", "says": "已为您撤回"},
     {"as": "agent@leon.demo", "decide": "approve", "comment": "", "refused": 409}
   ],
   "end": {"orders": {"SO20261012003": "paid"}, "refunds": {}, "approvals": {"withdrawn": 1}}},
  {"key": "a_question_then_a_request", "tenant": "leon", "why": "the question moves nothing; the request in its own words does",
   "steps": [
     {"as": "customer@leon.demo", "say": "SO20261008010 如果我申请退款，优惠券会退吗", "says": "SO20261008010 申请退款", "approval": false},
     {"check": {"approvals": {}, "refunds": {}}},
     {"as": "customer@leon.demo", "say": "SO20261008010 申请退款", "says": "人工审核", "approval": true}
   ],
   "end": {"orders": {"SO20261008010": "delivered"}, "refunds": {}, "approvals": {"pending": 1}}},
  {"key": "asked_then_taken_back", "tenant": "leon", "why": "a demand taken back in the same message files nothing",
   "steps": [
     {"as": "customer@leon.demo", "say": "SO20261008010 我要退款 算了不退了", "approval": false}
   ],
   "end": {"orders": {"SO20261008010": "delivered"}, "refunds": {}, "approvals": {}}},
  {"key": "carried_order_is_offered", "tenant": "leon", "why": "an order from the previous turn gets an offer, and only its number files",
   "steps": [
     {"as": "customer@leon.demo", "say": "SO20261008010 杯子收到就是碎的"},
     {"as": "customer@leon.demo", "say": "你没听懂吗 我说碎了！！要退钱", "says": "SO20261008010 申请退款", "approval": false},
     {"check": {"approvals": {}, "refunds": {}}},
     {"as": "customer@leon.demo", "say": "SO20261008010 申请退款", "approval": true}
   ],
   "end": {"approvals": {"pending": 1}}},
  {"key": "a_fourth_small_refund_goes_to_a_person", "tenant": "leon", "why": "three small refunds in 30 days: the velocity limit stops the fourth",
   "steps": [
     {"as": "customer2@leon.demo", "say": "SO20261015009 申请退款", "says": "人工审核", "approval": true}
   ],
   "end": {"orders": {"SO20261015009": "delivered"}, "approvals": {"pending": 1}}},
