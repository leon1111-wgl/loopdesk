# Copy to .env and edit. Every variable is optional; the defaults run fully offline.

# ---------- storage & auth ----------
LOOPDESK_DATABASE_URL=sqlite:///./loopdesk.db
# LOOPDESK_DATABASE_URL=postgresql+psycopg://loopdesk:loopdesk@localhost:5432/loopdesk
LOOPDESK_JWT_SECRET=please-replace-with-a-long-random-string-32-bytes-min
LOOPDESK_SEED_DEMO=1            # 0 in production: no demo tenants, no demo accounts on the login page
LOOPDESK_SEED_DEMO_TRAFFIC=1    # pre-fill a fresh demo with a few conversations

# ---------- model ----------
# mock = deterministic offline model (no key needed, used by tests and CI)
LOOPDESK_LLM_PROVIDER=mock
LOOPDESK_MOCK_STREAM_DELAY=0.02

# Doubao (Volcengine Ark), Hunyuan, DeepSeek, Qwen and OpenAI share one adapter:
# LOOPDESK_LLM_PROVIDER=openai_compat
# LOOPDESK_LLM_PRESET=doubao            # doubao | hunyuan | deepseek | qwen | openai
# LOOPDESK_LLM_API_KEY=...
# LOOPDESK_LLM_MODEL_STRONG=<model or endpoint id from the vendor console>
# LOOPDESK_LLM_MODEL_FAST=<a cheaper model for simple questions>
# LOOPDESK_LLM_STREAM_USAGE=1           # set 0 if a vendor rejects stream_options

# Claude (official SDK: pip install anthropic)
# LOOPDESK_LLM_PROVIDER=anthropic
# LOOPDESK_LLM_API_KEY=...
# LOOPDESK_ANTHROPIC_EFFORT=low

# Prices for the cost column, CNY per 1M tokens: {"model": [input, output]}
# LOOPDESK_PRICES={"your-model": [0.8, 2.0]}

# ---------- embeddings ----------
LOOPDESK_EMBEDDING_PROVIDER=hashing     # hashing (offline) | openai_compat
# LOOPDESK_EMBEDDING_MODEL=<embedding model id>
# LOOPDESK_EMBEDDING_DIM=1024

# ---------- agent behaviour ----------
LOOPDESK_EVIDENCE_MODE=annotate         # annotate: stream + mark unsupported sentences | strict: buffer and block
LOOPDESK_VERIFIER=lexical               # lexical | llm (LLM judge for paraphrasing models; number check always on)
LOOPDESK_MIN_RELEVANCE=0.3
LOOPDESK_MAX_AGENT_STEPS=6
LOOPDESK_RATE_LIMIT_PER_MINUTE=30
LOOPDESK_LOGIN_ATTEMPTS_PER_EMAIL=10   # login attempts per account per minute
LOOPDESK_LOGIN_ATTEMPTS_PER_IP=30      # per client IP per minute (behind a proxy: uvicorn --proxy-headers)
LOOPDESK_REFUND_WINDOW_DAYS=30       # refund velocity limits per customer
LOOPDESK_REFUND_WINDOW_MAX_COUNT=3
LOOPDESK_REFUND_WINDOW_MAX_AMOUNT=200
LOOPDESK_ANSWER_CACHE_TTL_HOURS=24   # 0 disables the knowledge-version-aware answer cache

# ---------- channels ----------
# LOOPDESK_FEISHU_APP_ID=cli_xxx
# LOOPDESK_FEISHU_APP_SECRET=...
# LOOPDESK_FEISHU_VERIFICATION_TOKEN=...
# LOOPDESK_WECOM_WEBHOOK_KEY=...         # group robot key for approval notifications
